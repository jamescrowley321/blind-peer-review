+const { jobs, files, scheduler } = require("../services");
+async function cleanup(now) {
+  const cutoff = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
+  const expired = await jobs.findBefore(cutoff);
+  for (const job of expired) {
+    await jobs.remove(job.id);
+  }
+}
+scheduler.daily(() => cleanup(new Date()));
+module.exports = cleanup;
