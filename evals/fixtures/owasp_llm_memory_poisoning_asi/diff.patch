+"use strict";
+
+const { chat } = require("./llm");
+const { browse } = require("./tools/browse");
+const store = require("./memory-store"); // shared across every user's sessions
+
+// Research agent with long-term memory: what it learns while browsing is kept
+// and prepended to the system prompt of every later session.
+async function research(question) {
+  const notes = await store.all();
+  const system = "You are a research assistant. Standing instructions and facts:\n" + notes.join("\n");
+  const page = await browse(question);
+  const reply = await chat({ system, input: `${question}\n\nSource page:\n${page.text}` });
+  if (reply.remember) await store.add(reply.remember); // model decides what to keep
+  return reply.text;
+}
+
+module.exports = { research };
